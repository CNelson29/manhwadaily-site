---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const email = 'contact@manhwadaily.com';
---
<Base
  title="Contact ManhwaDaily"
  description="Contact ManhwaDaily for corrections, broken links, copyright requests, privacy requests or partnerships."
  slug="contact"
>
  <Header />

  <main class="flex-1">
    <section class="border-b border-brand-border/50 py-14">
      <div class="max-w-3xl mx-auto px-4 sm:px-6">
        <p class="text-brand-coral text-sm font-semibold mb-3">ManhwaDaily</p>
        <h1 class="font-display font-black text-4xl sm:text-5xl text-brand-white mb-4">
          Contact
        </h1>
        <p class="text-brand-dim leading-relaxed">
          Email us at <a href={`mailto:${email}`} class="text-brand-coral hover:underline">{email}</a>.
          We read every message.
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
      <div class="prose prose-invert max-w-none">
        <h2>What to write to us about</h2>
        <ul>
          <li><strong>Corrections:</strong> a wrong title, status, chapter count or platform.
            Include the page URL and what should change.</li>
          <li><strong>Broken or outdated links:</strong> tell us which page and which link.</li>
          <li><strong>Copyright and takedown requests:</strong> identify the material and the page
            where it appears, and confirm you are the rights holder or authorized to act for them.
            We review every request and remove infringing material.</li>
          <li><strong>Privacy requests:</strong> access or deletion of personal data, as described in
            our <a href="/privacy/">Privacy Policy</a>.</li>
          <li><strong>AI Portrait orders:</strong> include your PayPal order ID.</li>
          <li><strong>Partnerships and advertising:</strong> platforms, publishers and creators are
            welcome to reach out.</li>
        </ul>

        <h2>Before you write</h2>
        <p>
          ManhwaDaily does not host chapters, so we cannot help you read a specific series. Our
          <a href="/best-sites-read-manhwa-online-free-2026/">where to read guide</a> lists the
          official platforms. To learn how we choose and check titles, see
          <a href="/about/">About ManhwaDaily</a>.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Base>
