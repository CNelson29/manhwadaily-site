---
import Base   from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';
import { coverForBody } from '../lib/manhwa-covers';
import Comments from '../components/Comments.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post }    = Astro.props;
const { data }    = post;
const { Content } = await post.render();
// Cover-forward: prefer the real cover of the first manhwa the post names.
const matched   = coverForBody(post.body);
const heroImage = matched?.cover ?? data.image;
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => a.data.date < b.data.date ? 1 : -1);
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .sort((a, b) => {
    const aScore = a.data.category === data.category ? 0 : 1;
    const bScore = b.data.category === data.category ? 0 : 1;
    return aScore - bScore || (a.data.date < b.data.date ? 1 : -1);
  })
  .slice(0, 4);

const dateFormatted = new Date(data.date).toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric',
});
const olympusSearch = `https://olympusbiblioteca.com/?s=${encodeURIComponent(data.title)}`;
const canonical = `https://manhwadaily.com/${post.slug}/`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: data.title,
  description: data.excerpt,
  datePublished: data.date,
  dateModified: data.dateModified ?? data.date,
  mainEntityOfPage: canonical,
  url: canonical,
  image: data.image ? `https://manhwadaily.com${data.image}` : 'https://manhwadaily.com/og-default.png',
  author: {
    '@type': 'Organization',
    name: 'ManhwaDaily',
    url: 'https://manhwadaily.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'ManhwaDaily',
    url: 'https://manhwadaily.com',
  },
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://manhwadaily.com/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: data.category,
      item: `https://manhwadaily.com/#${data.category.toLowerCase()}`,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: data.title,
      item: canonical,
    },
  ],
};

// FAQPage schema — extracted from the post's own "## FAQ" markdown section
// (### Q + paragraph A), so it can only ever describe FAQs actually visible
// in the rendered content. Ported from aitoolspot's [slug].astro.
const faqItems: { q: string; a: string }[] = [];
const headingMatch = post.body.match(/^## FAQ\s*\n/m);
if (headingMatch && headingMatch.index !== undefined) {
  const contentStart = headingMatch.index + headingMatch[0].length;
  const nextH2 = post.body.indexOf('\n## ', contentStart);
  const faqSection = nextH2 === -1 ? post.body.slice(contentStart) : post.body.slice(contentStart, nextH2);
  const blocks = ('\n' + faqSection).split('\n### ').slice(1);
  for (const block of blocks) {
    const nl = block.indexOf('\n');
    const q = (nl === -1 ? block : block.slice(0, nl)).trim();
    const a = (nl === -1 ? '' : block.slice(nl + 1)).trim().replace(/\s+/g, ' ');
    if (q && a) faqItems.push({ q, a });
  }
}
const faqSchema = faqItems.length ? JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map(({ q, a }) => ({
    '@type': 'Question', name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
}) : null;

const GRAD: Record<string, string> = {
  Action:'from-brand-coral/15', Romance:'from-pink-500/15',
  Fantasy:'from-purple-500/15', Isekai:'from-blue-500/15',
  Completed:'from-brand-teal/15', Rankings:'from-amber-500/15',
};
const grad = GRAD[data.category] ?? GRAD.Rankings;
---
<Base
  title={`${data.title} | ManhwaDaily`}
  description={data.excerpt}
  slug={post.slug}
  type="article"
  date={data.date}
>
  <Header />
  <main class="flex-1">
    <!-- Hero -->
    <div class={`bg-gradient-to-b ${grad} to-brand-bg border-b border-brand-border/40 py-10 relative overflow-hidden`}>
      <div class="speed-lines absolute inset-0 opacity-20"></div>
      <div class="relative max-w-3xl mx-auto px-4 sm:px-6">
        <nav class="flex items-center gap-2 text-sm text-brand-dim mb-5">
          <a href="/" class="hover:text-brand-coral transition-colors">Home</a>
          <span>›</span>
          <span class={`cat-badge cat-${data.category}`}>{data.category}</span>
        </nav>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-brand-white leading-tight mb-4">
          {data.title}
        </h1>
        <p class="text-brand-dim text-base leading-relaxed mb-4">{data.excerpt}</p>
        <div class="flex items-center gap-3 text-sm text-brand-dim">
          <span>📅 {dateFormatted}</span>
          {data.tags.slice(0,3).map(t => (
            <span class="px-2 py-0.5 rounded-full bg-brand-surface border border-brand-border text-xs">{t}</span>
          ))}
          <button id="btn-bookmark" data-slug={post.slug}
            class="ml-auto flex items-center gap-1 px-2.5 py-1 rounded-lg border border-brand-border text-brand-dim hover:text-brand-coral hover:border-brand-coral/40 transition-colors text-xs font-semibold">
            <span id="bookmark-icon">🔖</span> <span id="bookmark-label">Save</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Cover image: real manhwa cover on a blurred backdrop of itself (cover-forward) -->
    {heroImage && (
      <div class="max-w-3xl mx-auto px-4 sm:px-6 -mt-4 mb-0">
        <div class="relative w-full h-56 sm:h-72 rounded-2xl overflow-hidden border border-brand-border/40 shadow-lg">
          <img src={heroImage} alt="" aria-hidden="true"
               class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-50"
               referrerpolicy="no-referrer" />
          <div class="absolute inset-0 bg-brand-bg/30"></div>
          <img src={heroImage} alt={data.title}
               class={`relative mx-auto h-full ${matched ? 'w-auto object-contain py-3' : 'w-full object-cover'}`}
               referrerpolicy="no-referrer" loading="eager" />
        </div>
      </div>
    )}

    <!-- Content -->
    <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10">
      <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
      {faqSchema && <script type="application/ld+json" set:html={faqSchema} />}

      {data.linksVerified && data.linksVerified.length > 0 && (
        <div class="mb-6 p-4 rounded-xl border border-brand-coral/25 bg-brand-coral/5 text-sm">
          <p class="font-semibold text-brand-white mb-1">
            ✅ Every link on this list was checked on {new Date(data.dateModified ?? data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </p>
          <p class="text-brand-dim text-xs">
            {data.linksVerified.filter(l => l.ok).length}/{data.linksVerified.length} sites confirmed live and reachable — we re-check this list weekly instead of leaving it to rot like most "best sites" posts.
          </p>
        </div>
      )}

      <article class="prose prose-invert max-w-none" id="post-body">
        <Content />
      </article>

      <!-- Auto-illustrate: drop the real cover next to each manhwa the post names -->
      <script type="module">
        (async () => {
          const body = document.getElementById('post-body');
          if (!body) return;
          let data;
          try { data = await (await fetch('/manhwa-data.json')).json(); } catch { return; }
          const norm = s => (s || '').toLowerCase().normalize('NFKD').replace(/[^a-z0-9 ]/g, '').replace(/\s+/g, ' ').trim();
          const index = data.filter(m => m.cover && m.title).map(m => ({ ...m, key: norm(m.title) })).sort((a, b) => b.key.length - a.key.length);

          const cleanHeading = (txt) => norm(txt
            .replace(/^\s*#?\s*\d+\s*[—\-.):]+/, '')      // "#1 —", "2.", "3)"
            .replace(/[⭐★].*$/, '')                        // ratings after a star
            .replace(/[—\-]\s*(our\s*)?score.*$/i, '')     // "— Our Score: 9/10"
            .replace(/[—\-]\s*\d+(\.\d+)?\s*\/\s*10.*$/, '') // "— 9.3/10"
            .replace(/\(\d{4}\)/, ''));

          const used = new Set();
          body.querySelectorAll('h2, h3').forEach(h => {
            const key = cleanHeading(h.textContent || '');
            if (key.length < 4) return;
            const hit = index.find(m => !used.has(m.title) && (m.key === key || key.includes(m.key) || (m.key.length > 6 && m.key.includes(key))));
            if (!hit) return;
            used.add(hit.title);
            const fig = document.createElement('figure');
            fig.className = 'manhwa-cover-inject';
            fig.innerHTML =
              `<a href="${hit.url}" target="_blank" rel="noopener">` +
              `<img src="${hit.cover}" alt="${hit.title} cover" loading="lazy" referrerpolicy="no-referrer" />` +
              `<span>Read ${hit.title} →</span></a>`;
            h.insertAdjacentElement('afterend', fig);
          });
        })();
      </script>

      {relatedPosts.length > 0 && (
        <section class="mt-10">
          <div class="flex items-center justify-between gap-3 mb-4">
            <h2 class="font-display font-black text-xl text-brand-white">Related manhwa guides</h2>
            <a href="/" class="text-sm font-bold text-brand-coral hover:text-orange-300 transition-colors">
              View all
            </a>
          </div>
          <div class="grid gap-3 sm:grid-cols-2">
            {relatedPosts.map(related => (
              <a
                href={`/${related.slug}/`}
                class="block rounded-xl border border-brand-border bg-brand-surface/60 p-4 no-underline transition-colors hover:border-brand-coral/40"
              >
                <div class={`cat-badge cat-${related.data.category} mb-3`}>{related.data.category}</div>
                <h3 class="font-display text-base font-bold leading-snug text-brand-white">
                  {related.data.title}
                </h3>
                <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-brand-dim">
                  {related.data.excerpt}
                </p>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- Where to read CTA -->
      {data.category === 'Light Novels' ? (
        <div class="mt-10 p-6 rounded-2xl border border-brand-coral/20 bg-brand-surface text-center">
          <p class="font-display font-bold text-lg text-brand-white mb-1">Ready to start reading? 📖</p>
          <p class="text-brand-dim text-sm mb-4">
            {data.sourceLabel
              ? `This novel is translated and hosted by ${data.sourceLabel} — that's where new chapters get posted.`
              : `Find this light novel on its original translation site to read the latest chapters.`}
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {data.sourceUrl && (
              <a href={data.sourceUrl} target="_blank" rel="noopener noreferrer"
                class="px-4 py-2 rounded-lg bg-brand-coral text-white font-bold text-sm hover:bg-orange-400 transition-colors">
                Read at {data.sourceLabel || 'source site'}
              </a>
            )}
          </div>
        </div>
      ) : (
        <div class="mt-10 p-6 rounded-2xl border border-brand-coral/20 bg-brand-surface text-center">
          <p class="font-display font-bold text-lg text-brand-white mb-1">Ready to start reading? 📖</p>
          <p class="text-brand-dim text-sm mb-4">For Spanish readers, search Olympus Biblioteca. For official releases, check Webtoon, Tapas, or Lezhin Comics.</p>
          <div class="flex flex-wrap justify-center gap-3">
            <a href={olympusSearch} target="_blank" rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-brand-coral text-white font-bold text-sm hover:bg-orange-400 transition-colors">
              Olympus Biblioteca ES
            </a>
            <a href="https://www.webtoons.com" target="_blank" rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-brand-surface border border-brand-border text-brand-text font-bold text-sm hover:border-brand-coral/40 transition-colors">
              Webtoon
            </a>
            <a href="https://tapas.io" target="_blank" rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-brand-surface border border-brand-border text-brand-text font-bold text-sm hover:border-brand-coral/40 transition-colors">
              Tapas
            </a>
            <a href="https://www.lezhin.com" target="_blank" rel="noopener noreferrer"
              class="px-4 py-2 rounded-lg bg-brand-surface border border-brand-border text-brand-text font-bold text-sm hover:border-brand-coral/40 transition-colors">
              Lezhin
            </a>
          </div>
        </div>
      )}

      <!-- Manhwadaily products CTA -->
      <div class="mt-6 grid sm:grid-cols-2 gap-4">
        <a href="/portrait/" class="block p-5 rounded-2xl border border-brand-border bg-brand-surface hover:border-brand-coral/40 transition-colors">
          <p class="font-display font-bold text-base text-brand-white mb-1">🎨 Turn your photo into a medieval AI portrait</p>
          <p class="text-brand-dim text-sm">Free preview, print-ready poster if you like it. Made by us.</p>
        </a>
        <a href="/gate-crawler-world/" class="block p-5 rounded-2xl border border-brand-border bg-brand-surface hover:border-brand-coral/40 transition-colors">
          <p class="font-display font-bold text-base text-brand-white mb-1">⚔️ Play Gate Crawler World</p>
          <p class="text-brand-dim text-sm">Free open-world dungeon RPG, no sign-up. Farm loot, pick a class, fight in the Colosseum.</p>
        </a>
      </div>

      <Comments />
    </div>
  </main>

  <!-- Sticky mobile CTA — article pages only -->
  <div class="md:hidden fixed bottom-0 inset-x-0 z-40 border-t border-brand-coral/30 bg-brand-bg/95 backdrop-blur-md p-3"
       style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
    <a href="/recommender/"
       class="flex items-center justify-center gap-1.5 py-2.5 rounded-lg bg-brand-coral text-white font-bold text-sm">
      ✨ Find your manhwa
    </a>
  </div>
  <div class="md:hidden h-16" aria-hidden="true"></div>

  <script>
    import { getClerk } from '../lib/clerk-client';
    const PUBLISHABLE_KEY = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY;
    const btn = document.getElementById('btn-bookmark') as HTMLButtonElement | null;
    const slug = btn?.dataset.slug;

    if (PUBLISHABLE_KEY && btn && slug) {
      (async () => {
        const clerk = await getClerk(PUBLISHABLE_KEY);
        if (!clerk) return;

        function render() {
          const saved: string[] = (clerk.user?.unsafeMetadata?.myList as string[]) || [];
          const isSaved = saved.includes(slug!);
          document.getElementById('bookmark-icon')!.textContent = isSaved ? '✅' : '🔖';
          document.getElementById('bookmark-label')!.textContent = isSaved ? 'Saved' : 'Save';
        }
        render();
        clerk.addListener(render);

        btn.addEventListener('click', async () => {
          if (!clerk.user) {
            clerk.openSignIn({ afterSignInUrl: window.location.pathname });
            return;
          }
          const saved: string[] = (clerk.user.unsafeMetadata?.myList as string[]) || [];
          const next = saved.includes(slug!) ? saved.filter((s) => s !== slug) : [...saved, slug!];
          await clerk.user.update({ unsafeMetadata: { ...clerk.user.unsafeMetadata, myList: next } });
          render();
        });
      })();
    }
  </script>

  <Footer />
</Base>
