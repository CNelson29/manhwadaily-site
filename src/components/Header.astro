---
import SiteControls from './SiteControls.astro';
const { pathname } = Astro.url;
const CATS = ['Action','Romance','Fantasy','Isekai','Completed'];
---
<header class="sticky top-0 z-50 border-b border-brand-border/60 bg-brand-bg/85 backdrop-blur-md">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 group flex-shrink-0">
      <div class="w-8 h-8 rounded-xl bg-gradient-to-br from-brand-coral to-orange-500 flex items-center justify-center shadow-lg shadow-brand-coral/20">
        <span class="text-white font-black text-sm font-display">M</span>
      </div>
      <span class="font-display font-black text-lg text-brand-white group-hover:text-brand-coral transition-colors">
        Manhwa<span class="text-brand-coral">Daily</span>
      </span>
    </a>

    <!-- Category pills — desktop -->
    <div class="hidden md:flex items-center gap-0.5 overflow-x-auto min-w-0">
      {CATS.map(cat => (
        <a href={`/#${cat.toLowerCase()}`}
          class="px-2 py-1 rounded-lg text-xs font-semibold transition-colors text-brand-dim hover:text-brand-white hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">
          {cat}
        </a>
      ))}
      <span class="w-px h-4 bg-brand-border mx-0.5 flex-shrink-0"></span>
      <a href="/novelas/" class:list={["px-2 py-1 rounded-lg text-xs font-bold hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap", pathname.startsWith('/novelas') ? 'text-brand-coral' : 'text-brand-dim hover:text-brand-white']}>Novelas</a>
      <a href="/manhwa-dna/" class="px-2 py-1 rounded-lg text-xs font-bold text-brand-coral hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">🧬 DNA</a>
      <a href="/discover/" class="px-2 py-1 rounded-lg text-xs font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">Swipe</a>
      <a href="/gate-crawler/" class="px-2 py-1 rounded-lg text-xs font-bold text-brand-coral hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">🎮 Game</a>
      <a href="/gate-crawler-world/" class="px-2 py-1 rounded-lg text-xs font-bold text-brand-coral hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">🗺️ World</a>
      <a href="/tier-list/" class="px-2 py-1 rounded-lg text-xs font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">Tiers</a>
      <a href="/portrait/" class="px-2 py-1 rounded-lg text-xs font-bold text-brand-coral hover:bg-brand-surface uppercase tracking-wide whitespace-nowrap">🎨 Portrait</a>
    </div>

    <div class="flex items-center gap-2">
      <a href="/recommender/"
        class="flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-brand-coral text-white hover:bg-orange-400 transition-colors text-xs font-bold">
        ✨ Find your manhwa
      </a>
      <SiteControls />
      <a href="/rss.xml"
        class="hidden sm:flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-brand-border text-brand-dim hover:text-brand-coral hover:border-brand-coral/30 transition-colors text-xs font-semibold">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
        RSS
      </a>
      <button
        id="mobile-menu-btn"
        class="md:hidden flex items-center justify-center w-9 h-9 rounded-lg hover:bg-brand-surface transition-colors flex-shrink-0"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="mobile-menu-icon-open" class="w-5 h-5 text-brand-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="mobile-menu-icon-close" class="hidden w-5 h-5 text-brand-dim" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu panel -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-brand-border/60 bg-brand-bg">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {CATS.map(cat => (
        <a href={`/#${cat.toLowerCase()}`}
          class="px-3 py-2.5 rounded-lg text-sm font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface transition-colors">
          {cat}
        </a>
      ))}
      <div class="h-px bg-brand-border/60 my-1"></div>
      <a href="/novelas/" class="px-3 py-2.5 rounded-lg text-sm font-bold text-brand-coral hover:bg-brand-surface transition-colors">📖 Novelas ligeras</a>
      <a href="/manhwa-dna/" class="px-3 py-2.5 rounded-lg text-sm font-bold text-brand-coral hover:bg-brand-surface transition-colors">🧬 DNA</a>
      <a href="/discover/" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface transition-colors">Swipe</a>
      <a href="/gate-crawler/" class="px-3 py-2.5 rounded-lg text-sm font-bold text-brand-coral hover:bg-brand-surface transition-colors">🎮 Game</a>
      <a href="/gate-crawler-world/" class="px-3 py-2.5 rounded-lg text-sm font-bold text-brand-coral hover:bg-brand-surface transition-colors">🗺️ Gate Crawler World</a>
      <a href="/tier-list/" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface transition-colors">Tiers</a>
      <a href="/portrait/" class="px-3 py-2.5 rounded-lg text-sm font-bold text-brand-coral hover:bg-brand-surface transition-colors">🎨 AI Portrait</a>
      <a href="/rss.xml" class="px-3 py-2.5 rounded-lg text-sm font-semibold text-brand-dim hover:text-brand-white hover:bg-brand-surface transition-colors">RSS</a>
    </div>
  </div>
</header>

<script>
  const btn   = document.getElementById('mobile-menu-btn');
  const panel = document.getElementById('mobile-menu');
  const iconOpen  = document.getElementById('mobile-menu-icon-open');
  const iconClose = document.getElementById('mobile-menu-icon-close');

  function setOpen(open: boolean) {
    panel?.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
  }

  btn?.addEventListener('click', () => {
    setOpen(panel?.classList.contains('hidden') ?? false);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
